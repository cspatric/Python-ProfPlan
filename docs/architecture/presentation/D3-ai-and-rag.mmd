class I0,I1,I2,I3,I4,I5,I6 ing
class Q0,Q1,Q2 ret
class G0,G1,G2,G3 gate
class P0,P1,P2,P3,P4,P5,P6,P7,P8 plan
class T0,T1,T2,T3 trust
