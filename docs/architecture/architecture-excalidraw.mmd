class CLI,TRF,LG1 edge
class M1,M2,M3,M4,DISP,A_AUTH,A_CRUD,A_DOC,A_RAG,A_AI,A_GEN,A_AUD,A_OPS,LG2 api
class WRK,P1,P2,P3,P4,P5,GENT,FLW,LG3 asyn
class PG,RDS,MIO,OLL,ADM,LG4 data
class GW,CB,PC,PO,PGM,PL,LG5 llm
class OTC,TMP,PTL,LOK,NEX,PRM,GRF,LG6 obs
