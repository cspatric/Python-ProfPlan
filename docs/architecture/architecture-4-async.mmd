classDef port fill:#ffffff,stroke:#0b1220,stroke-width:2px,stroke-dasharray:4 3,color:#0b1220
classDef note fill:#fbfcfd,stroke:#cbd5e1,stroke-width:1px,color:#8794a5

class WRK,P1,P2,P3,P4,P5,GENT,MAILT,DLQ,FLW asyn
class BRK data
class IN2,OUT3,OUT5,OUT6 port
class BRK_N,WRK_N,P2_N,P3_N,P4_N,P5_N,GENT_N,MAILT_N,DLQ_N,FLW_N note
