classDef port fill:#ffffff,stroke:#0b1220,stroke-width:2px,stroke-dasharray:4 3,color:#0b1220
classDef note fill:#fbfcfd,stroke:#cbd5e1,stroke-width:1px,color:#8794a5

class STD,PTL,LOK,MET,NEX,PRM,OTL,OTC,TMP,GRF,ALM,SLO obs
class IN port
class STD_N,PTL_N,LOK_N,MET_N,NEX_N,PRM_N,OTL_N,OTC_N,TMP_N,GRF_N,ALM_N,SLO_N note
