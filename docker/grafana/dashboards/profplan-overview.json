{
 "uid": "profplan-overview",
 "title": "ProfPlan / Overview",
 "description": "Golden signals, dependencies, Celery and the LLM gateway. Every panel here backs an alert rule in docker/prometheus/rules/.",
 "tags": [
  "profplan"
 ],
 "timezone": "browser",
 "editable": true,
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "timepicker": {},
 "templating": {
  "list": []
 },
 "annotations": {
  "list": []
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "API \u2014 golden signals",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Request rate by status",
   "description": "Status codes are grouped by the instrumentator into 2xx/4xx/5xx.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 1
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (status) (rate(http_requests_total{job=\"api\"}[5m]))",
     "legendFormat": "{{status}}",
     "editorMode": "code",
     "range": true
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true,
     "calcs": []
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "custom": {},
     "mappings": [],
     "unit": "reqps",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "5xx ratio",
   "description": "Alerts at 2% sustained for 5 minutes (HighServerErrorRate).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 6,
    "x": 12,
    "y": 1
   },
   "targets": [
    {
     "refId": "A",
     "expr": "(sum(rate(http_requests_total{job=\"api\",status=\"5xx\"}[5m])) or vector(0)) / clamp_min(sum(rate(http_requests_total{job=\"api\"}[5m])), 0.001)",
     "legendFormat": "",
     "editorMode": "code",
     "range": true
    }
   ],
   "options": {
    "colorMode": "value",
    "graphMode": "area",
    "justifyMode": "auto",
    "orientation": "auto",
    "textMode": "auto",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "fieldConfig": {
    "defaults": {
     "custom": {},
     "mappings": [],
     "unit": "percentunit",
     "min": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.01
       },
       {
        "color": "red",
        "value": 0.02
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Requests under 500ms",
   "description": "Exact, unlike an interpolated quantile: the low-resolution histogram has a real 0.5s bucket.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 6,
    "x": 18,
    "y": 1
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(http_request_duration_seconds_bucket{job=\"api\",le=\"0.5\"}[5m])) / clamp_min(sum(rate(http_request_duration_seconds_count{job=\"api\"}[5m])), 0.001)",
     "legendFormat": "",
     "editorMode": "code",
     "range": true
    }
   ],
   "options": {
    "colorMode": "value",
    "graphMode": "area",
    "justifyMode": "auto",
    "orientation": "auto",
    "textMode": "auto",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "fieldConfig": {
    "defaults": {
     "custom": {},
     "mappings": [],
     "unit": "percentunit",
     "max": 1,
     "min": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.9
       },
       {
        "color": "green",
        "value": 0.95
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Latency percentiles (whole API)",
   "description": "From the high-resolution histogram, which has no handler label. Baseline: p95 545ms at 750 users.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 9
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_highr_seconds_bucket{job=\"api\"}[5m])))",
     "legendFormat": "p50",
     "editorMode": "code",
     "range": true
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_highr_seconds_bucket{job=\"api\"}[5m])))",
     "legendFormat": "p95",
     "editorMode": "code",
     "range": true
    },
    {
     "refId": "C",
     "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_highr_seconds_bucket{job=\"api\"}[5m])))",
     "legendFormat": "p99",
     "editorMode": "code",
     "range": true
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true,
     "calcs": []
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
