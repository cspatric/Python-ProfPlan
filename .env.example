# ===========================================================================
# Application
# ===========================================================================
APP_NAME=ProfPlan
APP_ENV=development
DEBUG=true
# Where secrets come from: `env` reads this file, `aws-ssm` reads SecureString
# parameters under SECRETS_PATH. See docs/deployment/SECRETS.md.
# Outside development the app refuses to start on the placeholders below;
# generate real ones with `python scripts/new_secret.py --all`.
SECRETS_PROVIDER=env
SECRETS_PATH=/profplan/production

SECRET_KEY=change-me
API_PREFIX=/api/v1
# CORS — comma-separated. Only used in development (production is same-origin
# behind Traefik). Vite dev server default is http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# ===========================================================================
# Database (PostgreSQL + pgvector)
# ===========================================================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=profplan
POSTGRES_PASSWORD=change-me
POSTGRES_DB=profplan
# Runtime traffic goes through PgBouncer (transaction pooling).
DATABASE_URL=postgresql+asyncpg://profplan:change-me@pgbouncer:6432/profplan
# Migrations and DDL bypass the pooler: they need a real session.
DATABASE_DIRECT_URL=postgresql+asyncpg://profplan:change-me@postgres:5432/profplan
# Tells the app to stop caching prepared statements. Required with
# transaction pooling; set it to false if you drop PgBouncer.
DB_PGBOUNCER=true

# ===========================================================================
# Redis
# ===========================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# ===========================================================================
# Celery
# ===========================================================================
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ===========================================================================
# Object storage (MinIO)
# ===========================================================================
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
MINIO_BUCKET=profplan
MINIO_SECURE=false

# ===========================================================================
# Authentication (JWT + cookies)
# ===========================================================================
# Generate strong values, e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Cookies — set COOKIE_SECURE=true behind HTTPS
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Login rate limiting (Redis) — per-account failed-attempt lockout
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# Global per-IP rate limiting (slowapi + Redis) — protects every route from
# floods/DoS. Limits use slowapi syntax "<count>/<period>".
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_EXPENSIVE=20/minute
RATE_LIMIT_STORAGE_URL=redis://redis:6379/3

# Security response headers (CSP, X-Frame-Options, ...). HSTS follows the
# environment by default (on in production); override with HSTS_ENABLED.
SECURITY_HEADERS_ENABLED=true
# HSTS_ENABLED=true

# Uploads — reject files larger than this before they can exhaust memory.
MAX_UPLOAD_SIZE_MB=100

# ===========================================================================
# AI / LLM providers
# ===========================================================================
# LLM gateway fallback chain: Claude -> OpenAI -> Ollama (local).
# Leave a key empty to skip that provider (Ollama needs no key).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_CHAT_MODEL=llama3.2:3b
LLM_MAX_TOKENS=8192
LLM_TIMEOUT_SECONDS=60
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_RESET_SECONDS=30
# Auto-generate the plan with AI on creation (planner + fan-out). Set false in
# environments without an LLM (e.g. CI) to create plain plans with no AI call.
PLAN_GENERATION_ENABLED=true
# Evaluate the planner's roadmap before using it. Code checks are free and
# always run; the LLM judge only runs when they flag something or the retrieved
# context was weak, so a clean plan still costs a single call.
PLANNER_EVAL_ENABLED=true
# Cosine distance (lower is closer) above which the closest retrieved chunk is
# too far from the request to have grounded the plan — worth judging.
PLANNER_WEAK_CONTEXT_DISTANCE=0.45
OLLAMA_BASE_URL=http://ollama:11434
# bge-m3 is multilingual (great for Portuguese) and 1024-dimensional.
# Must match EMBEDDING_DIMENSIONS in app/core/constants.py.
EMBEDDING_MODEL=bge-m3
# Cache embeddings in Redis to avoid re-embedding identical text (7 days).
EMBEDDING_CACHE_TTL_SECONDS=604800

# ===========================================================================
# Observability
# ===========================================================================
# Distributed tracing (needs the observability profile: otel-collector + tempo)
# Metrics probe — fills the dependency and queue-depth gauges the alert
# rules watch (Prometheus scrapes /metrics, never /ready).
METRICS_PROBE_ENABLED=true
METRICS_PROBE_INTERVAL_SECONDS=15
# Broker queues whose depth is exported, comma separated.
CELERY_QUEUES=celery

OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
LOG_LEVEL=INFO

# Uvicorn worker processes. One saturated core serves ~150 req/s, so this
# is the knob that buys throughput. Raise the api container's cpu limit
# alongside it, and never above 1 without PROMETHEUS_MULTIPROC_DIR set
# (compose does that for you).
UVICORN_WORKERS=1

# Email. In development the stack ships Mailpit: messages are delivered
# and readable at http://localhost:8025 instead of going anywhere real.
# Set EMAIL_ENABLED=false to log the message body instead of sending it.
EMAIL_ENABLED=true
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USE_TLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
# For real delivery, see docs/deployment/EMAIL.md. Resend, for example:
#   SMTP_HOST=smtp.resend.com, SMTP_PORT=587, SMTP_USE_TLS=true,
#   SMTP_USERNAME=resend, SMTP_PASSWORD=<the re_... API key>, and
#   EMAIL_FROM_ADDRESS=onboarding@resend.dev until a domain is verified.
EMAIL_FROM_ADDRESS=no-reply@profplan.local
EMAIL_FROM_NAME=ProfPlan
# Where the links in account emails point (the frontend consumes the
# token and calls the confirm endpoint).
FRONTEND_BASE_URL=http://localhost:5173
# Token lifetimes and whether an unverified account may sign in.
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=48
REQUIRE_EMAIL_VERIFICATION=false

# Sign in with Google. Leave the client id empty and the two endpoints are
# not registered at all, which is how the stack runs by default: the flow
# needs credentials from a real Google Cloud project, so an endpoint that
# exists without them could only ever fail.
#
# To turn it on: Google Cloud console, APIs & Services, Credentials, create
# an OAuth client of type "Web application", and register the callback below
# as an authorised redirect URI. It must match character for character.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5173/api/v1/auth/oauth/google/callback
# Where the browser lands after the callback has set the cookies.
OAUTH_SUCCESS_REDIRECT=http://localhost:5173/subjects
OAUTH_FAILURE_REDIRECT=http://localhost:5173/login

# Read-only database role for the Grafana cost dashboard. Generate one with
# `python scripts/new_secret.py`. Left empty, the role is not created and the
# per-account spend panels are the only thing that stops working.
GRAFANA_DB_PASSWORD=

# Amazon Bedrock. Authenticated with a Bedrock API key in an Authorization
# bearer header, so no boto3, no credential chain and no request signing.
# Create one in the Bedrock console under "API keys".
#
# BEDROCK_MODEL must be an *inference profile* id for Anthropic's newer
# models: `us.anthropic.claude-sonnet-5`, not `anthropic.claude-sonnet-5`.
# The bare foundation-model id answers "not available for this account", which
# reads like a permissions problem and is not one. Model access still has to be
# granted for the account, in the console, per model.
BEDROCK_API_KEY=
BEDROCK_REGION=us-east-1
BEDROCK_MODEL=us.anthropic.claude-sonnet-5
# The model this provider answers a FAST call with. Empty means it has only
# one model and uses it for everything.
BEDROCK_FAST_MODEL=us.amazon.nova-lite-v1:0

# Which providers answer which class of call, in order. The standard chain
# takes the calls that decide something (the roadmap, its judge); the fast one
# takes the bulk, one activity at a time, which is where the tokens are.
LLM_STANDARD_CHAIN=claude,bedrock,openai,gemini,ollama
LLM_FAST_CHAIN=gemini,bedrock,openai,ollama
