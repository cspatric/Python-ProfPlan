# ---------------------------------------------------------------------------
# Secrets / environment
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# Self-signed local TLS cert (generate with `make certs`) and ACME storage.
docker/traefik/certs/*
!docker/traefik/certs/.gitkeep
docker/traefik/acme/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Virtual environments
.venv/
venv/
env/
ENV/

# ---------------------------------------------------------------------------
# Claude Code
# ---------------------------------------------------------------------------
.claude/settings.local.json

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Local data / volumes
# ---------------------------------------------------------------------------
*.log
logs/
data/
postgres-data/
minio-data/
redis-data/

# Alertmanager receiver secret (see docker/alertmanager/alertmanager.yml)
docker/alertmanager/slack_api_url

# Built documents. The LaTeX source and its parts are versioned; the PDF is
# two `pdflatex` runs away (see docs/study/README.md) and would otherwise
# change wholesale on every rebuild.
docs/study/*.pdf
backups/

# Presentation scripts. They live outside this repository on purpose — they are
# personal speaking notes, not project documentation, and they go stale the
# moment the code moves. Ignored here so that copying one in never commits it.
roteiro*.txt
roteiro*.md

# Terraform: local state, the plugin cache and any plan file. State holds the
# database password and every generated secret, so it never belongs in git.
infra/.terraform/
infra/*.tfstate
infra/*.tfstate.*
infra/*.tfplan
infra/*.tfvars
!infra/*.tfvars.example
